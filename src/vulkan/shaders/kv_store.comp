#version 460
layout(local_size_x = 256) in;
#include "common.glsl"
// Store `total` values (consecutive tokens of n each) of k and v as f16 into the caches from position step[0].
layout(push_constant) uniform P { F32 k; F32 v; U16 kc; U16 vc; I32 step; uint n; uint total; } p;
void main() {
    uint i = gl_GlobalInvocationID.x, e = uint(p.step.v[0]) * p.n + i;
    if (i < p.total) { p.kc.v[e] = uint16_t(f2h(p.k.v[i])); p.vc.v[e] = uint16_t(f2h(p.v.v[i])); }
}
