#version 460
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require
layout(local_size_x = 256) in;
#include "common.glsl"
layout(push_constant) uniform P { F32 x; F32 ye; F32 w; F32 sh; F32 sg; MB mb; I32 step; I32 slots; U32 err; uint k; uint y_off; uint n; } p;

// x += sum_j w[j] ye[j] + sigmoid(sg) sh + cpu (sh and mb may be null). If a slot missed, wait for the CPU worker's
// done flag (word 16) first; after about 2 s it gives up and sets err[0], which the host reports. Workgroup y =
// token: x, ye, w, slots, sh, sg and the CPU result advance by one token's worth.
const uint SPINS = 1u << 23;
shared bool miss;
void main() {
    uint seq = uint(p.step.v[1]), tk = gl_WorkGroupID.y, k = p.k, n = p.n;
    bool mbx = uint64_t(p.mb) != 0;
    if (gl_LocalInvocationID.x == 0) {
        bool m = false;
        if (mbx) for (uint j = 0; j < k; j++) m = m || p.slots.v[tk * k + j] < 0;
        if (m) {
            uint spins = 0;
            // An acquire load under the Vulkan memory model: a plain volatile load (or an atomic add) keeps reading a
            // cached copy and never sees the host's write.
            while (atomicLoad(p.mb.v[16], gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsAcquire | gl_SemanticsMakeVisible) != seq)
                if (++spins == SPINS) { p.err.v[0] = 1; break; }
        }
        miss = m;
    }
    barrier();
    uint i = gl_GlobalInvocationID.x;
    if (i >= n) return;
    precise float y = 0.0;
    for (uint j = 0; j < k; j++) {
        float wj = p.w.v[tk * k + j];
        if (wj != 0.0) y = fma(wj, p.ye.v[(tk * k + j) * n + i], y);
    }
    if (miss) y += uintBitsToFloat(p.mb.v[p.y_off + tk * n + i]);
    if (uint64_t(p.sh) != 0) y = fma(sigmoid(p.sg.v[tk]), p.sh.v[tk * n + i], y);
    p.x.v[tk * n + i] += y;
}
