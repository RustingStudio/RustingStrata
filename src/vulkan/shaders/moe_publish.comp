#version 460
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require
layout(local_size_x = 256) in;
#include "common.glsl"
layout(push_constant) uniform P { I32 ids; F32 wts; I32 slots; F32 h; MB mb; I32 step; uint k; uint n; uint h_off; uint T; } p;

// Copy one layer's routing for T tokens (k entries each) to the host-mapped mailbox (activations only if an expert
// missed), store T in word 1, then raise the request flag (word 0) to step[1]. One workgroup.
shared bool miss;
void main() {
    uint t = gl_LocalInvocationID.x, kt = p.k * p.T;
    if (t == 0) miss = false;
    barrier();
    if (t < kt && p.slots.v[t] < 0) miss = true;
    barrier();
    if (t < kt) { p.mb.v[32 + t] = uint(p.ids.v[t]); p.mb.v[32 + kt + t] = floatBitsToUint(p.wts.v[t]); p.mb.v[32 + 2 * kt + t] = uint(p.slots.v[t]); }
    if (miss) for (uint i = t; i < p.n * p.T; i += 256) p.mb.v[p.h_off + i] = floatBitsToUint(p.h.v[i]);
    if (t == 0) p.mb.v[1] = p.T;
    barrier();
    if (t == 0) atomicStore(p.mb.v[0], uint(p.step.v[1]), gl_ScopeDevice, gl_StorageSemanticsBuffer, gl_SemanticsRelease | gl_SemanticsMakeAvailable);
}
