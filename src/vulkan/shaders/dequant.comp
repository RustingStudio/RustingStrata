#version 460
// Weight rows of type T to f32: one workgroup per row (CUDA dequant_*).
layout(local_size_x = 256) in;
#include "common.glsl"
#include "deq.glsl"

layout(push_constant) uniform P { U8 w; F32 o; uint nsb; } p;

void main() {
    uint row = gl_WorkGroupID.x;
    float v[8];
    for (uint s = gl_LocalInvocationID.x; s < p.nsb * 32; s += 256) {
        deq8(p.w, (row * p.nsb + (s >> 5)) * SBB, s & 31, v);
        uint o = (row * p.nsb + (s >> 5)) * 256 + (s & 31) * 8;
        for (uint i = 0; i < 8; i++) p.o.v[o + i] = v[i];
    }
}
