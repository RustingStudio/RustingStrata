#version 460
// Prefill GEMM on int8 cooperative matrices, as gemmi_q in kernels.cu: x comes from quant_q8, weights from qi8 as int8
// with a scale (and min) per 16, and each exact int32 product sum over one weight scale (KS = 16 or 32 deep) is
// scaled into the f32 sums in the order and with the roundings of the CUDA kernel (its SASS: ptxas fuses some of
// the PTX's mul and sub), so results match bit for bit.
// Tiles, grid and act as gemm_f.
#extension GL_KHR_cooperative_matrix : require
#extension GL_KHR_memory_scope_semantics : require
layout(local_size_x = 256) in;
#include "common.glsl"
#include "deq.glsl"
layout(buffer_reference, std430, buffer_reference_align = 8) buffer U64 { uint64_t v[]; };
layout(push_constant) uniform P { U64 tiles; uint64_t wd; U32 x; I32 xrow; F32 y; uint nd; uint ys; uint rows; uint nsb; uint act; } p;
const uint BM = 128;
const bool MIN = T == 10 || T == 12 || T == 13;
const uint KS = T == 8 || T == 12 || T == 13 || T == 16 || T == 19 || T == 18 || T == 21 || T == 23 ? 32 : 16;
// Rows in words. The int8 products are 32 deep: for KS = 16, x row holds each 16 values followed by 16 zeros.
const uint PX = 36, PW = 20;
shared uint xq[BM * PX], wq[64 * PW];
shared float xd[BM][2], xsum[BM][4], wsc[64][4], wmn[64][4];
shared int ix[512];  // the row and column index matrices
#define IACC coopmat<int, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>

void main() {
    uint tid = gl_LocalInvocationID.x, w = gl_SubgroupID, n0 = gl_WorkGroupID.x * 64, cols = p.nsb * 256;
    uint wm = (w >> 1) * 32, wn = (w & 1) * 32, m0, cnt;
    U8 wt;
    if (uint64_t(p.tiles) != 0) {
        uint64_t t = p.tiles.v[2 * gl_WorkGroupID.y + 1];
        wt = U8(p.tiles.v[2 * gl_WorkGroupID.y]); m0 = uint(t); cnt = uint(t >> 32);
    } else {
        wt = U8(p.wd); m0 = gl_WorkGroupID.y * BM; cnt = min(BM, p.nd - m0);
    }
    for (uint i = tid; i < 256; i += 256) { ix[i] = int(i / 16); ix[256 + i] = int(i % 16); }
    barrier();
    // Accumulator element i of this invocation is at row ri[i], column ci[i] (the layout is the implementation's).
    IACC ri, ci;
    coopMatLoad(ri, ix, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(ci, ix, 256, 16, gl_CooperativeMatrixLayoutRowMajor);
    // X: invocation copies 32 int8 (half of the row's 64 per step) of row xr, plus its scales (xh = 0) or sums (xh = 1).
    uint xr = tid >> 1, xh = tid & 1, xo = 0;
    bool xok = xr < cnt;
    if (xok) xo = (uint64_t(p.xrow) != 0 ? uint(p.xrow.v[m0 + xr]) : m0 + xr) * (cols + cols / 8 + cols / 4) / 4;
    // W: invocation decodes the 16 weights (subs 2 wi, 2 wi + 1 of the step) of row wr.
    uint wr = tid >> 2, wi = tid & 3;
    bool wok = n0 + wr < p.rows;
    precise float acc[2][2][8];
    for (uint a = 0; a < 2; a++) for (uint b = 0; b < 2; b++) for (uint i = 0; i < 8; i++) acc[a][b][i] = 0.0;
    for (uint kb = 0; kb < p.nsb * 4; kb++) {
        for (uint j = 0; j < 8; j++) {
            uint v = xok ? p.x.v[xo + kb * 16 + xh * 8 + j] : 0;
            if (KS == 32) xq[xr * PX + xh * 8 + j] = v;
            else { uint c = 2 * xh + j / 4; xq[xr * PX + c * 8 + j % 4] = v; xq[xr * PX + c * 8 + 4 + j % 4] = 0; }
        }
        if (xh == 0) for (uint j = 0; j < 2; j++) xd[xr][j] = xok ? uintBitsToFloat(p.x.v[xo + cols / 4 + kb * 2 + j]) : 0.0;
        else for (uint j = 0; j < 4; j++) xsum[xr][j] = xok ? uintBitsToFloat(p.x.v[xo + cols / 4 + cols / 32 + kb * 4 + j]) : 0.0;
        int q[16]; float d = 0.0, m = 0.0, d1, m1;
        for (uint j = 0; j < 16; j++) q[j] = 0;
        if (wok) {
            uint b = ((n0 + wr) * p.nsb + kb / 4) * SBB, sub = (kb & 3) * 8 + 2 * wi;
            int q0[8], q1[8];
            qi8(wt, b, sub, q0, d, m);
            qi8(wt, b, sub + 1, q1, d1, m1);
            for (uint j = 0; j < 8; j++) { q[j] = q0[j]; q[8 + j] = q1[j]; }
        }
        for (uint j = 0; j < 4; j++) wq[wr * PW + wi * 4 + j] = pack4(q[4 * j], q[4 * j + 1], q[4 * j + 2], q[4 * j + 3]);
        wsc[wr][wi] = d; wmn[wr][wi] = m;
        barrier();
        for (uint h = 0; h < 64 / KS; h++) {
            coopmat<int8_t, gl_ScopeSubgroup, 16, 32, gl_MatrixUseA> a[2];
            coopmat<int8_t, gl_ScopeSubgroup, 32, 16, gl_MatrixUseB> b[2];
            for (uint i = 0; i < 2; i++) {
                coopMatLoad(a[i], xq, (wm + 16 * i) * PX + h * 8, PX, gl_CooperativeMatrixLayoutRowMajor);
                coopMatLoad(b[i], wq, (wn + 16 * i) * PW + h * KS / 4, PW, gl_CooperativeMatrixLayoutColumnMajor);
            }
            for (uint mt = 0; mt < 2; mt++)
                for (uint nt = 0; nt < 2; nt++) {
                    IACC c = coopMatMulAdd(a[mt], b[nt], IACC(0));
                    for (uint i = 0; i < c.length(); i++) {
                        uint r = wm + 16 * mt + ri[i], n = wn + 16 * nt + ci[i];
                        precise float da = xd[r][h * KS / 32], s = da * wsc[n][h * KS / 16];
                        if (MIN) {
                            precise float sa = KS == 32 ? xsum[r][2 * h] + xsum[r][2 * h + 1] : xsum[r][h];
                            precise float f = fma(float(c[i]), s, -(sa * wmn[n][h * KS / 16]));
                            acc[mt][nt][i] = acc[mt][nt][i] + f;
                        } else {
                            acc[mt][nt][i] = fma(float(c[i]), s, acc[mt][nt][i]);
                        }
                    }
                }
        }
        barrier();
    }
    for (uint mt = 0; mt < 2; mt++)
        for (uint nt = 0; nt < 2; nt++)
            for (uint i = 0; i < ri.length(); i++) {
                uint r = wm + 16 * mt + ri[i], n = n0 + wn + 16 * nt + ci[i];
                if (r >= cnt || n >= p.rows) continue;
                uint o = (m0 + r) * p.ys + n;
                float v = acc[mt][nt][i];
                p.y.v[o] = p.act == 0 ? v : p.act == 1 ? silu(p.y.v[o]) * v : p.y.v[o] + v;
            }
}
