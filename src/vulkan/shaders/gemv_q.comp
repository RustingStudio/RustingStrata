#version 460
// y[t * ys + row] = W[row] . x[t] for t < nt (at most 4), with x pre-quantized by quant_xq at xq (nt rows of 256 nsb
// int8 values, then their scales, one per 32): one subgroup per row, 8 rows per workgroup (CUDA gemv_row_qn).
// nt is specialization constant 5, as CUDA's template NT: a runtime count leaves acc indexed dynamically.
layout(local_size_x = 256) in;
#include "common.glsl"
#include "deq.glsl"
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

layout(push_constant) uniform P { U8 w; U32 xq; F32 y; uint ys; uint rows; uint nsb; } p;
layout(constant_id = 5) const uint NT = 1;

void sb_step(F32 xd, uint row, uint lane, uint s, inout precise float acc[NT]) {
    uint lo, hi; float d, m;
    qw(p.w, (row * p.nsb + s) * SBB, lane, lo, hi, d, m);
    [[unroll]] for (uint t = 0; t < NT; t++) {
        uint o = (t * p.nsb + s) * 64 + lane * 2, a = p.xq.v[o], c = p.xq.v[o + 1];
        int dot = dotPacked4x8EXT(int(lo), int(a)) + dotPacked4x8EXT(int(hi), int(c));
        int sx = dotPacked4x8EXT(0x01010101, int(a)) + dotPacked4x8EXT(0x01010101, int(c));
        float dx = xd.v[(t * p.nsb + s) * 8 + (lane >> 2)];
        acc[t] = fma(d * dx, float(dot), acc[t]);
        if (T == 10 || T == 12 || T == 13) acc[t] = fma(-(m * dx), float(sx), acc[t]);  // types with a min
    }
}

void main() {
    uint row = gl_WorkGroupID.x * 8 + gl_SubgroupID, lane = gl_SubgroupInvocationID;
    if (row >= p.rows) return;
    F32 xd = F32(uint64_t(p.xq) + NT * p.nsb * 256);
    precise float acc[NT];
    [[unroll]] for (uint t = 0; t < NT; t++) acc[t] = 0.0;
    // Four super-blocks per iteration so their loads overlap (kernels.cu: unroll 4); the sums keep their order.
    uint s = 0;
    for (; s + 4 <= p.nsb; s += 4) [[unroll]] for (uint j = 0; j < 4; j++) sb_step(xd, row, lane, s + j, acc);
    for (; s < p.nsb; s++) sb_step(xd, row, lane, s, acc);
    [[unroll]] for (uint t = 0; t < NT; t++) {
        float a = warp_sum(acc[t]);
        if (lane == 0) p.y.v[t * p.ys + row] = a;
    }
}
