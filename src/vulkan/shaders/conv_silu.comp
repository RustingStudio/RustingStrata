#version 460
layout(local_size_x = 128) in;
#include "common.glsl"
layout(buffer_reference, std430, buffer_reference_align = 8) buffer U64 { uint64_t v[]; };
// Causal depthwise conv over [state..., current] then SiLU; state keeps the last kw-1 inputs, oldest first.
// Workgroup = 128 channels; the first nn workgroups are then l2-normalized as l2_norm does (the decode q and k heads).
// tab (not null): workgroup y is row y, at qkv and y + y * ch, with its state at tab[2y] (step_batch).
layout(push_constant) uniform P { F32 qkv; F32 state; F32 w; F32 y; uint ch; uint kw; uint nn; float eps; U64 tab; } p;
void main() {
    uint c = gl_GlobalInvocationID.x, kw = p.kw, ch = p.ch;
    F32 qkv = p.qkv, state = p.state, y = p.y;
    if (uint64_t(p.tab) != 0) {
        uint r = gl_WorkGroupID.y;
        state = F32(p.tab.v[2 * r]); qkv = F32(uint64_t(p.qkv) + 4ul * r * ch); y = F32(uint64_t(p.y) + 4ul * r * ch);
    }
    float v = 0.0;
    if (c < ch) {
        float acc = 0.0;
        for (uint k = 0; k < kw - 1; k++) acc += state.v[k * ch + c] * p.w.v[c * kw + k];
        acc += qkv.v[c] * p.w.v[c * kw + kw - 1];
        v = silu(acc);
        for (uint k = 0; k + 2 < kw; k++) state.v[k * ch + c] = state.v[(k + 1) * ch + c];
        state.v[(kw - 2) * ch + c] = qkv.v[c];
    }
    if (gl_WorkGroupID.x < p.nn) v *= fdiv(1.0, max(sqrt_(block_sum(v * v)), p.eps));
    if (c < ch) y.v[c] = v;
}
