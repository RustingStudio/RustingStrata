#version 460
layout(local_size_x = 256) in;
#include "common.glsl"
// Workgroup = row t (at x + t * xs): quant_x into the gemvn layout at q, all int8 rows, then all scales.
layout(push_constant) uniform P { F32 x; U32 q; uint xs; uint n; } p;
void main() {
    uint t = gl_WorkGroupID.x;
    quant_x(p.x, t * p.xs, p.n, F32(0ul), 0.0, p.q, t * p.n / 4, F32(uint64_t(p.q) + gl_NumWorkGroups.x * p.n), t * (p.n / 32));
}
