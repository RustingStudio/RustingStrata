#version 460
layout(local_size_x = 32) in;
#include "common.glsl"
layout(push_constant) uniform P { I32 ids; I32 table; I32 slots; F32 wts; F32 wh; uint k; } p;

// Expert cache lookup: slots[j] = table[ids[j]] (-1 = not resident); wh[j] = routing weight of hits, else 0.
void main() {
    uint j = gl_LocalInvocationID.x;
    if (j >= p.k) return;
    int s = p.table.v[p.ids.v[j]];
    p.slots.v[j] = s;
    p.wh.v[j] = s >= 0 ? p.wts.v[j] : 0.0;
}
