#version 460
// y[t * ys + row] = W[row] . x[t * xs ..] for t < nt (at most 4): one subgroup per row, lane l covers elements
// [8l, 8l + 8) of every super-block (CUDA gemv_row). nt is specialization constant 5, as in gemv_q.
layout(local_size_x = 32) in;
#include "common.glsl"
#include "deq.glsl"

layout(push_constant) uniform P { U8 w; F32 x; F32 y; uint xs; uint ys; uint nsb; } p;
layout(constant_id = 5) const uint NT = 1;

void main() {
    uint row = gl_WorkGroupID.x, lane = gl_LocalInvocationID.x;
    float acc[NT], v[8];
    for (uint t = 0; t < NT; t++) acc[t] = 0.0;
    for (uint s = 0; s < p.nsb; s++) {
        deq8(p.w, (row * p.nsb + s) * SBB, lane, v);
        for (uint t = 0; t < NT; t++) {
            uint o = t * p.xs + s * 256 + lane * 8;
            acc[t] += v[0] * p.x.v[o] + v[1] * p.x.v[o + 1] + v[2] * p.x.v[o + 2] + v[3] * p.x.v[o + 3]
                    + v[4] * p.x.v[o + 4] + v[5] * p.x.v[o + 5] + v[6] * p.x.v[o + 6] + v[7] * p.x.v[o + 7];
        }
    }
    for (uint t = 0; t < NT; t++) {
        float a = warp_sum(acc[t]);
        if (lane == 0) p.y.v[t * p.ys + row] = a;
    }
}
