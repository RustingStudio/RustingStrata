#version 460
#pragma use_vulkan_memory_model
#extension GL_KHR_memory_scope_semantics : require
// moe_gemv_q (xg 1) of the down experts, then moe_combine of their rows, in one dispatch: workgroup (row block,
// token tk) covers rows r0 .. r0 + rpw of all k slots of token tk; subgroup w takes slots w, w + 8, .. and leaves its
// sums in shared memory, then invocation i combines row r0 + i as moe_combine does (same order, same result).
layout(local_size_x = 256) in;
#include "common.glsl"
#define SHARED_TABLES
#include "deq.glsl"
#extension GL_EXT_integer_dot_product : require
#extension GL_EXT_control_flow_attributes : require

layout(push_constant) uniform P { U8 w; I32 slots; U32 xq; uint64_t stride; F32 x; F32 wh; F32 sh; F32 sg; MB mb; I32 step; U32 err;
                                  uint rows; uint nsb; uint ntok; uint k; uint y_off; uint rpw; } p;

void sb_step(U8 w, F32 xd, uint row, uint lane, uint t, uint s, inout precise float acc) {
    uint lo, hi; float d, m;
    qw_sb(w, (row * p.nsb + s) * SBB, lane, true, lo, hi, d, m);
    uint o = (t * p.nsb + s) * 64 + lane * 2, a = p.xq.v[o], c = p.xq.v[o + 1];
    int dot = dotPacked4x8EXT(int(lo), int(a)) + dotPacked4x8EXT(int(hi), int(c));
    int sx = dotPacked4x8EXT(0x01010101, int(a)) + dotPacked4x8EXT(0x01010101, int(c));
    float dx = xd.v[(t * p.nsb + s) * 8 + (lane >> 2)];
    acc = fma(d * dx, float(dot), acc);
    if (MIN) acc = fma(-(m * dx), float(sx), acc);  // types with a min
}

void sb_step2(U8 w, F32 xd, uint row0, uint row1, uint lane, uint t, uint s, inout precise float acc0, inout precise float acc1) {
    uint lo0, hi0, lo1, hi1; float d0, m0, d1, m1;
    qw_sb(w, (row0 * p.nsb + s) * SBB, lane, true, lo0, hi0, d0, m0);
    qw_sb(w, (row1 * p.nsb + s) * SBB, lane, true, lo1, hi1, d1, m1);
    uint o = (t * p.nsb + s) * 64 + lane * 2, a = p.xq.v[o], c = p.xq.v[o + 1];
    float dx = xd.v[(t * p.nsb + s) * 8 + (lane >> 2)];
    int dot0 = dotPacked4x8EXT(int(lo0), int(a)) + dotPacked4x8EXT(int(hi0), int(c));
    int dot1 = dotPacked4x8EXT(int(lo1), int(a)) + dotPacked4x8EXT(int(hi1), int(c));
    acc0 = fma(d0 * dx, float(dot0), acc0);
    acc1 = fma(d1 * dx, float(dot1), acc1);
    if (MIN) {
        int sx = dotPacked4x8EXT(0x01010101, int(a)) + dotPacked4x8EXT(0x01010101, int(c));
        acc0 = fma(-(m0 * dx), float(sx), acc0);
        acc1 = fma(-(m1 * dx), float(sx), acc1);
    }
}

void sb_step_pre(U8 w, uint row, uint lane, uint s, uint a, uint c, float dx, int sx, inout precise float acc) {
    uint lo, hi; float d, m;
    qw_sb(w, (row * p.nsb + s) * SBB, lane, true, lo, hi, d, m);
    int dot = dotPacked4x8EXT(int(lo), int(a)) + dotPacked4x8EXT(int(hi), int(c));
    acc = fma(d * dx, float(dot), acc);
    if (MIN) acc = fma(-(m * dx), float(sx), acc);
}

void sb_step2_pre(U8 w, uint row0, uint row1, uint lane, uint s, uint a, uint c, float dx, int sx, inout precise float acc0, inout precise float acc1) {
    sb_step_pre(w, row0, lane, s, a, c, dx, sx, acc0);
    sb_step_pre(w, row1, lane, s, a, c, dx, sx, acc1);
}

#include "mb_wait.glsl"
const uint RPW = 8;  // rows per workgroup (rpw) at most
shared float part[32 * RPW];
shared bool miss, ok;
void main() {
    load_tables();
    uint tk = gl_WorkGroupID.y, k = p.k, lane = LANE, n = p.rows;
    uint rpw = p.rpw, r0 = gl_WorkGroupID.x * rpw;
    F32 xd = F32(uint64_t(p.xq) + p.ntok * p.nsb * 256);
    for (uint j = WARP; j < k; j += 8) {
        uint t = tk * k + j;
        int e = p.slots.v[t];
        if (e < 0) continue;  // a miss: weight 0, the CPU's result is added below
        U8 w = U8(uint64_t(p.w) + uint64_t(e) * p.stride);
        if (p.nsb == 2u) {
            uint o0 = t * 2u * 64u + lane * 2u, o1 = o0 + 64u;
            uint a0 = p.xq.v[o0], c0 = p.xq.v[o0 + 1u];
            uint a1 = p.xq.v[o1], c1 = p.xq.v[o1 + 1u];
            float dx0 = xd.v[(t * 2u) * 8u + (lane >> 2u)];
            float dx1 = xd.v[(t * 2u + 1u) * 8u + (lane >> 2u)];
            int sx0 = MIN ? (dotPacked4x8EXT(0x01010101, int(a0)) + dotPacked4x8EXT(0x01010101, int(c0))) : 0;
            int sx1 = MIN ? (dotPacked4x8EXT(0x01010101, int(a1)) + dotPacked4x8EXT(0x01010101, int(c1))) : 0;
            uint i = 0;
            for (; i + 1 < rpw && r0 + i + 1 < n; i += 2) {
                precise float acc0 = 0.0, acc1 = 0.0;
                sb_step2_pre(w, r0 + i, r0 + i + 1, lane, 0u, a0, c0, dx0, sx0, acc0, acc1);
                sb_step2_pre(w, r0 + i, r0 + i + 1, lane, 1u, a1, c1, dx1, sx1, acc0, acc1);
                acc0 = warp_sum(acc0); acc1 = warp_sum(acc1);
                if (lane == 0) { part[j * RPW + i] = acc0; part[j * RPW + i + 1] = acc1; }
            }
            for (; i < rpw && r0 + i < n; i++) {
                precise float acc = 0.0;
                sb_step_pre(w, r0 + i, lane, 0u, a0, c0, dx0, sx0, acc);
                sb_step_pre(w, r0 + i, lane, 1u, a1, c1, dx1, sx1, acc);
                acc = warp_sum(acc);
                if (lane == 0) part[j * RPW + i] = acc;
            }
            continue;
        }
        uint i = 0;
        for (; i + 1 < rpw && r0 + i + 1 < n; i += 2) {
            precise float acc0 = 0.0, acc1 = 0.0;
            uint s = 0;
            for (; s + 2 <= p.nsb; s += 2) [[unroll]] for (uint q = 0; q < 2; q++) sb_step2(w, xd, r0 + i, r0 + i + 1, lane, t, s + q, acc0, acc1);
            for (; s < p.nsb; s++) sb_step2(w, xd, r0 + i, r0 + i + 1, lane, t, s, acc0, acc1);
            acc0 = warp_sum(acc0); acc1 = warp_sum(acc1);
            if (lane == 0) { part[j * RPW + i] = acc0; part[j * RPW + i + 1] = acc1; }
        }
        for (; i < rpw && r0 + i < n; i++) {
            precise float acc = 0.0;
            uint s = 0;
            for (; s + 2 <= p.nsb; s += 2) [[unroll]] for (uint q = 0; q < 2; q++) sb_step(w, xd, r0 + i, lane, t, s + q, acc);
            for (; s < p.nsb; s++) sb_step(w, xd, r0 + i, lane, t, s, acc);
            acc = warp_sum(acc);
            if (lane == 0) part[j * RPW + i] = acc;
        }
    }
    if (gl_LocalInvocationID.x == 0) {
        // As moe_combine: all tokens wait if any missed, so all of x is written or none.
        bool m = false, any = false;
        if (uint64_t(p.mb) != 0) for (uint j = 0; j < gl_NumWorkGroups.y * k; j++) if (p.slots.v[j] < 0) { any = true; m = m || j / k == tk; }
        ok = !any || mb_wait(p.mb, uint(p.step.v[1]), p.err);
        miss = m;
    }
    barrier();
    uint i = gl_LocalInvocationID.x, r = r0 + i;
    if (i >= rpw || r >= n || !ok) return;
    precise float y = 0.0;
    for (uint j = 0; j < k; j++) {
        float wj = p.wh.v[tk * k + j];
        if (wj != 0.0) y = fma(wj, part[j * RPW + i], y);
    }
    if (miss) y += uintBitsToFloat(p.mb.v[p.y_off + tk * n + r]);
    if (uint64_t(p.sh) != 0) y = uint64_t(p.sg) != 0 ? fma(sigmoid(p.sg.v[tk]), p.sh.v[tk * n + r], y) : y + p.sh.v[tk * n + r];
    p.x.v[tk * n + r] += y;
}
